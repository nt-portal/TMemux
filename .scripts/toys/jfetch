32|get_init() {
33|    os="$(uname -o)"
34|    if [ "$os" = "Android" ]; then
35|       echo "init.rc"
36|    elif [ ! $(pidof systemd) ]; then
37|        if [ -f "/sbin/openrc" ]; then
38|            echo "openrc"
39|        else
40|         echo $(cat /proc/1/comm)
41|        fi
42|    else
43|        echo "systemD"
44|    fi
